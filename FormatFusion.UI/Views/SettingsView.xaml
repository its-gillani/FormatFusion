<Page x:Class="FormatFusion.UI.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource ThemeWindowBackgroundBrush}"
      Title="Settings">
    <ScrollViewer Margin="48,32">
        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource ThemeTitleText}" Margin="0,0,0,32" />

            <!-- General -->
            <TextBlock Text="General" Style="{StaticResource ThemeSubtitleText}" Margin="0,0,0,12" />
            <Border Style="{StaticResource ThemeCardBorder}" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Default output folder:" Style="{StaticResource ThemeBodyText}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding DefaultOutputFolder}" IsReadOnly="True" Style="{StaticResource ThemeTextBox}" />
                        <Button Grid.Column="2" ToolTip="Browse" Style="{StaticResource ThemeButtonSecondary}"
                                Margin="8,0,0,0" Command="{Binding BrowseOutputFolderCommand}" BorderThickness="0" Padding="8,4">
                            <Path Data="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" 
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                  StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" 
                                  Fill="Transparent" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                    </Grid>
                    <CheckBox Style="{StaticResource ThemeCheckBox}" Content="Open folder after completion" IsChecked="{Binding OpenFolderAfterCompletion}"
                              Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,8" />
                    <CheckBox Style="{StaticResource ThemeCheckBox}" Content="Clear temp files on exit" IsChecked="{Binding ClearTempOnExit}"
                              Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Performance -->
            <TextBlock Text="Performance" Style="{StaticResource ThemeSubtitleText}" Margin="0,0,0,12" />
            <Border Style="{StaticResource ThemeCardBorder}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Max concurrent jobs:" Style="{StaticResource ThemeBodyText}" VerticalAlignment="Center" />
                    <ComboBox Style="{StaticResource ThemeComboBox}" Grid.Column="1" ItemsSource="{Binding AvailableConcurrentJobs}" SelectedItem="{Binding MaxConcurrentJobs}" Width="80" />
                </Grid>
            </Border>

            <!-- About -->
            <TextBlock Text="About" Style="{StaticResource ThemeSubtitleText}" Margin="0,0,0,12" />
            <Border Style="{StaticResource ThemeCardBorder}">
                <StackPanel>
                    <TextBlock Text="FormatFusion" Style="{StaticResource ThemeTitleText}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}"
                               Style="{StaticResource ThemeBodySecondaryText}" Margin="0,0,0,12" />
                    <TextBlock Text="Development Team:" Style="{StaticResource ThemeBodyText}" FontWeight="SemiBold" Margin="0,4,0,2" />
                    <StackPanel Margin="8,0,0,12">
                        <TextBlock Style="{StaticResource ThemeBodySecondaryText}">
                            • <Hyperlink NavigateUri="https://github.com/its-gillani" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource ThemeAccentBrush}">Abdul Subhan (@its-gillani)</Hyperlink> — Lead Developer
                        </TextBlock>
                        <TextBlock Style="{StaticResource ThemeBodySecondaryText}">
                            • <Hyperlink NavigateUri="https://github.com/de1nonlyzohaib" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource ThemeAccentBrush}">Zohaib Ahmad (@de1nonlyzohaib)</Hyperlink> — Co-Developer &amp; UI Developer
                        </TextBlock>
                    </StackPanel>
                    <Button Content="Open Source Licenses" Style="{StaticResource ThemeButtonSecondary}"
                            HorizontalAlignment="Left" Command="{Binding OpenLicensesCommand}" BorderThickness="0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>


