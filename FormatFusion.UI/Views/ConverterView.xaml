<Page x:Class="FormatFusion.UI.Views.ConverterView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource ThemeWindowBackgroundBrush}"
      Title="Convert">

    <Grid Margin="48,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="← Back" Style="{StaticResource ThemeButtonSecondary}"
                    Command="{Binding GoBackCommand}" BorderThickness="0" />
            <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource ThemeTitleText}">
                        <Setter Property="Text" Value="Convert Format" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCodecMode}" Value="True">
                                <Setter Property="Text" Value="Convert Codec" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Grid.Column="2" Content="+ Add More Files" Style="{StaticResource ThemeButtonSecondary}"
                    Command="{Binding AddMoreFilesCommand}" />
        </Grid>

        <!-- File List + Options -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- File List -->
                <Border Style="{StaticResource ThemeCardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Files" Style="{StaticResource ThemeSubtitleText}" Margin="0,0,0,16" />
                        <ItemsControl ItemsSource="{Binding Files}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ThemeSurfaceHoverBrush}"
                                            CornerRadius="6"
                                            Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="{Binding CategoryIcon}" 
                                                  Stroke="{DynamicResource ThemeTextPrimaryBrush}" 
                                                  StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" 
                                                  Fill="Transparent" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                                       Style="{StaticResource ThemeBodyText}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding FileSizeFormatted}"
                                                       Style="{StaticResource ThemeCaptionText}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="3" Width="150"
                                                      ItemsSource="{Binding CodecOptions}"
                                                      SelectedValuePath="CodecName"
                                                      SelectedValue="{Binding SelectedCodec}"
                                                      Margin="12,0">
                                                 <ComboBox.ItemTemplate>
                                                     <DataTemplate>
                                                         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                             <Path Data="{Binding IconGeometry}" 
                                                                   Fill="Transparent" Stroke="{Binding TextColor}" StrokeThickness="2"
                                                                   Width="12" Height="12" Margin="0,0,8,0" Stretch="Uniform"
                                                                   Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVis}}" 
                                                                   VerticalAlignment="Center"/>
                                                             <TextBlock Text="{Binding CodecName}" Foreground="{Binding TextColor}" 
                                                                        ToolTip="{Binding WarningMessage}" VerticalAlignment="Center"/>
                                                         </StackPanel>
                                                     </DataTemplate>
                                                 </ComboBox.ItemTemplate>
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource ThemeComboBox}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>
                                            <ComboBox Grid.Column="4" Width="150"
                                                      ItemsSource="{Binding AvailableOutputFormats}"
                                                      SelectedItem="{Binding SelectedOutputFormat}"
                                                      Margin="12,0,12,0">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource ThemeComboBox}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsCodecMode, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>
                                            <Button Grid.Column="5" Content="✕"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="{DynamicResource ThemeTextTertiaryBrush}"
                                                    Command="{Binding RemoveCommand}"
                                                    Cursor="Hand" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Output Options -->
                <Border Style="{StaticResource ThemeCardBorder}">
                    <StackPanel>
                        <TextBlock Text="Output" Style="{StaticResource ThemeSubtitleText}" Margin="0,0,0,16" />
                                                <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Output Folder:" Style="{StaticResource ThemeBodyText}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox Grid.Column="1" Text="{Binding OutputFolder}"
                                     IsReadOnly="True" VerticalAlignment="Center" Style="{StaticResource ThemeTextBox}" />
                            <Button Grid.Column="2" Content="&#x1F4C2; Browse" Style="{StaticResource ThemeButtonSecondary}"
                                    Margin="8,0,0,0" Command="{Binding BrowseOutputFolderCommand}" />
                        </Grid>
                        <CheckBox Style="{StaticResource ThemeCheckBox}" Content="Open folder after conversion" IsChecked="{Binding OpenAfterConversion}"
                                  Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,8" />
                        <CheckBox Style="{StaticResource ThemeCheckBox}" Content="Overwrite existing files" IsChecked="{Binding OverwriteExisting}"
                                  Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,16" />

                        <!-- Hardware Acceleration -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Hardware Acceleration:" Style="{StaticResource ThemeBodyText}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox Style="{StaticResource ThemeComboBox}" Grid.Column="1" ItemsSource="{Binding BackendOptions}"
                                      SelectedValuePath="BackendName"
                                      SelectedValue="{Binding AppSettings.HardwareBackend}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{Binding IconGeometry}" Fill="{Binding TextColor}" 
                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"
                                                  Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVis}}"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding BackendName}" Foreground="{Binding TextColor}" ToolTip="{Binding WarningMessage}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <!-- Video Codec -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Video Codec:" Style="{StaticResource ThemeBodyText}" />
                                <TextBlock Text="Applies to files set to Global Change" Style="{StaticResource ThemeCaptionText}" Opacity="0.7" />
                            </StackPanel>
                            <ComboBox Style="{StaticResource ThemeComboBox}" Grid.Column="1" ItemsSource="{Binding GlobalCodecOptions}"
                                      SelectedValuePath="CodecName"
                                      SelectedValue="{Binding AppSettings.VideoCodec}" VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{Binding IconGeometry}" Fill="{Binding TextColor}" 
                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"
                                                  Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVis}}"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CodecName}" Foreground="{Binding TextColor}" ToolTip="{Binding WarningMessage}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <!-- Best-effort disclaimer banner -->
                        <Border Background="#2A1B1B" CornerRadius="6" Padding="12,8" Margin="0,16,0,0"
                                Visibility="{Binding ShowBestEffortWarning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Foreground="{DynamicResource ThemeWarningBrush}" TextWrapping="Wrap"
                                       Text="&#x26A0; PDF &#x2192; Word conversion is best-effort. Complex formatting, tables, and scanned PDFs may not convert perfectly." />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer area -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,24,0,0">
            <TextBlock Text="{Binding ConflictMessage}" 
                       Foreground="{Binding ConflictMessageBrush}" 
                       Visibility="{Binding ShowConflictMessage, Converter={StaticResource BoolToVis}}" 
                       VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Content="Convert Now &#x2192;"
                    Style="{StaticResource ThemeButtonPrimary}"
                    Command="{Binding ConvertCommand}"
                    IsEnabled="{Binding CanConvert}" />
        </StackPanel>
    </Grid>
</Page>
