<Page x:Class="FormatFusion.UI.Views.CompressorView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource ThemeWindowBackgroundBrush}"
      Title="Smart Compressor">

    <Grid Margin="48,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Button Content="← Back" Style="{StaticResource ThemeButtonSecondary}" BorderThickness="0"
                    HorizontalAlignment="Left" Command="{Binding GoBackCommand}" />
            <TextBlock Text="Smart Compressor" Style="{StaticResource ThemeTitleText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- File Info Card -->
                <Border Style="{StaticResource ThemeCardBorder}" Margin="0,0,0,16">
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding FileName}" Style="{StaticResource ThemeSubtitleText}" />
                            <TextBlock Text="{Binding FileInfo}" Style="{StaticResource ThemeBodySecondaryText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Change File"
                                Style="{StaticResource ThemeButtonSecondary}"
                                Command="{Binding ChangeFileCommand}"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Target Size Input -->
                <Border Style="{StaticResource ThemeCardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Target Size" Style="{StaticResource ThemeSubtitleText}" Margin="0,0,0,16" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding TargetSizeMB, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="28" FontWeight="SemiBold"
                                     TextAlignment="Right"
                                     Style="{StaticResource ThemeTextBox}"
                                     VerticalContentAlignment="Center"
                                     Padding="12,8" />
                            <TextBlock Grid.Column="1" Text="MB" Style="{StaticResource ThemeTitleText}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Estimate Card -->
                <Border Style="{StaticResource ThemeCardBorder}" Margin="0,0,0,16"
                        Visibility="{Binding HasEstimate, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Estimate" Style="{StaticResource ThemeSubtitleText}" />
                            <Border Grid.Column="1" CornerRadius="4" Padding="8,4"
                                    Background="{Binding EstimateBadgeBackground}">
                                <TextBlock Text="{Binding EstimateBadgeText}"
                                           Foreground="White" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <!-- Size comparison bars -->
                        <StackPanel Margin="0,0,0,12">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Original" Style="{StaticResource ThemeCaptionText}" VerticalAlignment="Center" />
                                <ProgressBar Style="{StaticResource ThemeProgressBar}" Grid.Column="1" Value="100" Maximum="100"
                                             Foreground="{DynamicResource ThemeTextTertiaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding OriginalSizeFormatted}"
                                           Style="{StaticResource ThemeCaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Target" Style="{StaticResource ThemeCaptionText}" VerticalAlignment="Center" />
                                <ProgressBar Style="{StaticResource ThemeProgressBar}" Grid.Column="1" Value="{Binding TargetBarPercent}" Maximum="100"
                                              />
                                <TextBlock Grid.Column="2" Text="{Binding TargetSizeFormatted}"
                                           Style="{StaticResource ThemeCaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Estimated" Style="{StaticResource ThemeCaptionText}" VerticalAlignment="Center" />
                                <ProgressBar Style="{StaticResource ThemeProgressBar}" Grid.Column="1" Value="{Binding EstimateBarPercent}" Maximum="100"
                                             Foreground="{DynamicResource ThemeSuccessBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding EstimateSizeFormatted}"
                                           Style="{StaticResource ThemeCaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <!-- Details -->
                        <TextBlock Text="{Binding EstimateDetails}"
                                   Style="{StaticResource ThemeBodySecondaryText}" Margin="0,8,0,0" />

                        <!-- Quality Warning Banner -->
                        <Border Background="#2A1B1B" CornerRadius="6" Padding="12,8" Margin="0,12,0,0"
                                Visibility="{Binding ShowQualityWarning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding QualityWarningText}"
                                       Foreground="{DynamicResource ThemeWarningBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Output Options -->
                <Border Style="{StaticResource ThemeCardBorder}">
                    <StackPanel>
                        <TextBlock Text="Output" Style="{StaticResource ThemeSubtitleText}" Margin="0,0,0,16" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Format:" Style="{StaticResource ThemeBodyText}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox Style="{StaticResource ThemeComboBox}" Grid.Column="1" ItemsSource="{Binding OutputFormats}"
                                      SelectedItem="{Binding SelectedOutputFormat}"  />
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Output Folder:" Style="{StaticResource ThemeBodyText}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox Grid.Column="1" Text="{Binding OutputFolder}" IsReadOnly="True" Style="{StaticResource ThemeTextBox}" />
                            <Button Grid.Column="2" Content="📁" Style="{StaticResource ThemeButtonSecondary}"
                                    Margin="8,0,0,0" Command="{Binding BrowseOutputFolderCommand}" BorderThickness="0"/>
                        </Grid>
                                                <!-- Hardware Acceleration -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Hardware Acceleration:" Style="{StaticResource ThemeBodyText}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox Style="{StaticResource ThemeComboBox}" Grid.Column="1" 
                                      ItemsSource="{Binding BackendOptions}"
                                      SelectedValuePath="BackendName"
                                      SelectedValue="{Binding AppSettings.HardwareBackend}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{Binding IconGeometry}" Fill="{Binding TextColor}" 
                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"
                                                  Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVis}}"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding BackendName}" Foreground="{Binding TextColor}" ToolTip="{Binding WarningMessage}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <!-- Video Codec -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Video Codec:" Style="{StaticResource ThemeBodyText}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox Style="{StaticResource ThemeComboBox}" Grid.Column="1" 
                                      ItemsSource="{Binding GlobalCodecOptions}"
                                      SelectedValuePath="CodecName"
                                      SelectedValue="{Binding AppSettings.VideoCodec}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{Binding IconGeometry}" Fill="{Binding TextColor}" 
                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"
                                                  Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVis}}"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CodecName}" Foreground="{Binding TextColor}" ToolTip="{Binding WarningMessage}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer area -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,24,0,0">
            <TextBlock Text="{Binding ConflictMessage}" 
                       Foreground="{Binding ConflictMessageBrush}" 
                       Visibility="{Binding ShowConflictMessage, Converter={StaticResource BoolToVis}}" 
                       VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Content="Compress Now &#x2192;"
                    Style="{StaticResource ThemeButtonPrimary}"
                    Command="{Binding CompressCommand}"
                    IsEnabled="{Binding CanCompress}" />
        </StackPanel>
    </Grid>
</Page>

