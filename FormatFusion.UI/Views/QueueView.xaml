<Page x:Class="FormatFusion.UI.Views.QueueView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource ThemeWindowBackgroundBrush}"
      Title="Queue">

    <Grid Margin="48,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding StatusSummary}"
                       Style="{StaticResource ThemeTitleText}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="3" Content="✕ Terminate All"
                    Style="{StaticResource ThemeButtonSecondary}" BorderThickness="0"
                    Command="{Binding CancelAllCommand}"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- Job List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Jobs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ThemeCardBorder}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Job Header Row -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{Binding FileTypeIcon}"
                                          Stroke="{DynamicResource ThemeTextPrimaryBrush}" 
                                          StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" 
                                          Fill="Transparent"
                                          Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" Style="{StaticResource ThemeBodyText}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding OperationLabel}"
                                                   Style="{StaticResource ThemeCaptionText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeLabel}"
                                               Style="{StaticResource ThemeCaptionText}"
                                               VerticalAlignment="Center" Margin="16,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding DurationLabel}"
                                               Style="{StaticResource ThemeCaptionText}"
                                               VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                                        <Button ToolTip="Open Output File"
                                                Style="{StaticResource ThemeButtonSecondary}" BorderThickness="0"
                                                Command="{Binding OpenFileCommand}"
                                                Visibility="{Binding CanOpenFile, Converter={StaticResource BoolToVis}}"
                                                Padding="8,4" Margin="0,0,4,0">
                                            <Path Data="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" 
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                                  StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" 
                                                  Fill="Transparent" Width="14" Height="14" Stretch="Uniform" />
                                        </Button>
                                        <Button Style="{StaticResource ThemeButtonSecondary}" BorderThickness="0"
                                                Command="{Binding CancelCommand}"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                                                Padding="8,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M18 6 6 18M6 6l12 12" 
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                                      StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" 
                                                      Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Text="Cancel" VerticalAlignment="Center" FontSize="11" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Progress Bar -->
                                <Grid Grid.Row="1" Margin="0,0,0,6" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                    <ProgressBar Style="{StaticResource ThemeProgressBar}" Value="{Binding ProgressPercent}" />
                                </Grid>

                                <!-- Status Line -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding CurrentPhase}"
                                               Style="{StaticResource ThemeCaptionText}" />
                                    <TextBlock Grid.Column="1" Text="{Binding EtaLabel}"
                                               Style="{StaticResource ThemeCaptionText}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Resource Monitor Bar -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeSurfaceHoverBrush}"
                CornerRadius="6" Padding="16,8" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding CpuUsageLabel}" Style="{StaticResource ThemeCaptionText}" Margin="0,0,24,0" />
                <TextBlock Text="{Binding ActiveJobsLabel}" Style="{StaticResource ThemeCaptionText}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>



