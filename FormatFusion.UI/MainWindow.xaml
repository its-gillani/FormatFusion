<Window x:Class="FormatFusion.UI.MainWindow" FocusVisualStyle="{x:Null}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FormatFusion" Icon="pack://application:,,,/icon.ico"
        MinWidth="1000" MinHeight="700"
        Width="1300" Height="850"
        Background="{DynamicResource ThemeWindowBackgroundBrush}"
        FontFamily="{StaticResource InterFont}" >



        <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"  />
    </WindowChrome.WindowChrome>

    <Grid FocusVisualStyle="{x:Null}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />  <!-- Title bar / nav -->
            <RowDefinition Height="*" />   <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ── Title Bar ── -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeSurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo + App Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" 
                           Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="FormatFusion" Style="{StaticResource ThemeSubtitleText}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Nav Pills -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="NavHomeBtn" Content="Home" Style="{StaticResource ThemeButtonSecondary}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Margin="4,0" Click="NavHome_Click" BorderThickness="0"/>
                    <Button x:Name="NavQueueBtn" Content="Queue" Style="{StaticResource ThemeButtonSecondary}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Margin="4,0" Click="NavQueue_Click" BorderThickness="0"/>
                    <Button x:Name="NavSettingsBtn" Content="Settings" Style="{StaticResource ThemeButtonSecondary}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Margin="4,0" Click="NavSettings_Click" BorderThickness="0"/>
                </StackPanel>

                <!-- Utilities -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpenFolderBtn" ToolTip="Open Output Folder"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource ThemeButtonSecondary}" BorderThickness="0" Background="Transparent"
                            Click="OpenFolderBtn_Click">
                        <Path Data="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" 
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" 
                              Fill="Transparent" Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                    <ToggleButton x:Name="DarkModeToggle" Style="{StaticResource ThemeToggleButtonSecondary}"
                                  WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,16,0"
                                  Background="Transparent" BorderThickness="0"
                                  Checked="DarkModeToggle_Checked"
                                  Unchecked="DarkModeToggle_Unchecked"
                                  ToolTip="Toggle Theme">
                        <Path Data="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" 
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" 
                              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" 
                              Fill="Transparent" Width="16" Height="16" Stretch="Uniform" />
                    </ToggleButton>

                    <!-- Window Controls -->
                    <Button x:Name="MinimizeBtn" WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ThemeButtonSecondary}" BorderThickness="0" Background="Transparent" Click="MinimizeBtn_Click" ToolTip="Minimize" Width="36" Padding="0">
                        <Path Data="M4 12h16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="MaximizeBtn" WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ThemeButtonSecondary}" BorderThickness="0" Background="Transparent" Click="MaximizeBtn_Click" ToolTip="Maximize" Width="36" Padding="0">
                        <Path Data="M4 4h16v16H4z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent" Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="CloseBtn" WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ThemeButtonSecondary}" BorderThickness="0" Background="Transparent" Click="CloseBtn_Click" ToolTip="Close" Width="36" Padding="0">
                        <Path Data="M18 6L6 18M6 6l12 12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Main Content Frame ── -->
        <Frame Grid.Row="1" x:Name="MainFrame"
               NavigationUIVisibility="Hidden"
               Background="{DynamicResource ThemeWindowBackgroundBrush}" />
    </Grid>
</Window>

