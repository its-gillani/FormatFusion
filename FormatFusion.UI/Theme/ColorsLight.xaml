<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light Mode Colors -->
    <!-- Window & Surfaces -->
    <Color x:Key="WindowBackgroundColor">#FAF9F6</Color>
    <Color x:Key="SurfaceBackgroundColor">#FFFFFF</Color>
    <Color x:Key="SurfaceHoverColor">#F0EFEA</Color>
    
    <!-- Borders -->
    <Color x:Key="BorderColor">#E2E0D8</Color>
    <Color x:Key="BorderHoverColor">#D5D2C8</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#2D2A26</Color>
    <Color x:Key="TextSecondaryColor">#6D6962</Color>
    <Color x:Key="TextTertiaryColor">#A39F98</Color>

    <!-- Accents (Terracotta) -->
    <Color x:Key="AccentColor">#D46A4A</Color>
    <Color x:Key="AccentHoverColor">#B85538</Color>
    <Color x:Key="AccentPressedColor">#A0472E</Color>
    <Color x:Key="AccentForegroundColor">#FFFFFF</Color>

    <!-- Semantic -->
    <Color x:Key="SuccessColor">#3A734C</Color>
    <Color x:Key="WarningColor">#C58A38</Color>
    <Color x:Key="ErrorColor">#C24B4B</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="ThemeWindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="ThemeSurfaceBackgroundBrush" Color="{StaticResource SurfaceBackgroundColor}" />
    <SolidColorBrush x:Key="ThemeSurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ThemeBorderHoverBrush" Color="{StaticResource BorderHoverColor}" />
    
    <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="ThemeTextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    
    <SolidColorBrush x:Key="ThemeAccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ThemeAccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="ThemeAccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="ThemeAccentForegroundBrush" Color="{StaticResource AccentForegroundColor}" />

    <SolidColorBrush x:Key="ThemeSuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="ThemeWarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ThemeErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ThemeStructuralConflictBrush" Color="#B5443A" />
    <SolidColorBrush x:Key="ThemeHardwareConflictBrush" Color="#B8873A" />
</ResourceDictionary>
